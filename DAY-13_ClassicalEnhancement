55.0\n","\n","    corrected = np.power(normalized, gamma)\n","\n","    corrected = corrected * 255.0\n","\n","    corrected = np.clip(corrected, 0, 255).astype(np.uint8)\n","\n","    return corrected\n","\n","print(\"Gamma Correction function created.\")"]},{"cell_type":"code","execution_count":10,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":56,"status":"ok","timestamp":1789395218234,"user":{"displayName":"Sanjana Reddem","userId":"12244514584460782585"},"user_tz":-330},"id":"nrIb52SARAIg","outputId":"02af90cb-b4a5-40bd-f66a-2f8afe8ef3bc"},"outputs":[{"name":"stdout","output_type":"stream","text":["White Balance function created.\n"]}],"source":["# DAY 13 - CELL 5\n","# Classical Baseline 3: White Balance\n","\n","def apply_white_balance(image):\n","\n","    image_float = image.astype(np.float32)\n","\n","    mean_r = np.mean(image_float[:, :, 0])\n","    mean_g = np.mean(image_float[:, :, 1])\n","    mean_b = np.mean(image_float[:, :, 2])\n","\n","    mean_gray = (mean_r + mean_g + mean_b) / 3\n","\n","    image_float[:, :, 0] *= mean_gray / (mean_r + 1e-8)\n","    image_float[:, :, 1] *= mean_gray / (mean_g + 1e-8)\n","    image_float[:, :, 2] *= mean_gray / (mean_b + 1e-8)\n","\n","    image_float = np.clip(image_float, 0, 255)\n","\n","    return image_float.astype(np.uint8)\n","\n","print(\"White Balance function created.\")"]},{"cell_type":"code","execution_count":null,"metadata":{"colab":{"background_save":true,"output_embedded_package_id":"1SCu0zpEcurfNXIXxdrto8kWasg-IBbJ8"},"id":"P7FAgugnRAFM","outputId":"3f071af1-10df-40cf-9b7c-bf2ff53f66fc"},"outputs":[],"source":["# DAY 13 - CELL 6\n","# Visual comparison of classical methods\n","\n","for input_path, target_path in sample_pairs:\n","\n","    input_image = np.array(\n","        Image.open(input_path).convert(\"RGB\")\n","    )\n","\n","    target_image = np.array(\n","        Image.open(target_path).convert(\"RGB\")\n","    )\n","\n","    clahe_image = apply_clahe(